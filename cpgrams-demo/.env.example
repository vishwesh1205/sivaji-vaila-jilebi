# Local SQLite storage (used when CPGRAMS_DB_URL is empty).
# CPGRAMS_DB_PATH=./data/cpgrams_demo.db
# CPGRAMS_UPLOAD_DIR=./data/uploads

# Durable production database. Required for Vercel because its local filesystem
# is ephemeral. Create a free Turso database and copy its libsql:// URL/token.
# CPGRAMS_DB_URL=libsql://your-database.turso.io
# CPGRAMS_DB_AUTH_TOKEN=

# Change this for any shared or long-running local demo.
# CPGRAMS_SESSION_SECRET=replace-with-a-long-random-string

# Destructive reset endpoint is disabled unless this is exactly 1.
# CPGRAMS_ALLOW_RESET=0

# Optional integration with the existing AICTE complaint dashboard.
# Leave DASHBOARD_INGEST_URL empty to keep the integration fully disabled.
# DASHBOARD_INGEST_URL=http://127.0.0.1:8000/ingest/json
# DASHBOARD_TIMEOUT_SECONDS=4
#
# Preferred: the demo logs in automatically and refreshes an expired token.
# Use a dedicated dashboard account for this integration, not a real admin login.
# DASHBOARD_USERNAME=cpgrams.demo@example.test
# DASHBOARD_PASSWORD=replace-with-a-strong-password
# Optional; derived from DASHBOARD_INGEST_URL when omitted.
# DASHBOARD_LOGIN_URL=http://127.0.0.1:8000/auth/login
#
# Fallback for a short-lived manual token. Expired tokens are refreshed only
# when DASHBOARD_USERNAME/DASHBOARD_PASSWORD are also configured.
# DASHBOARD_BEARER_TOKEN=
